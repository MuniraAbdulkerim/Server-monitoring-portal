{
  "name": "server-monitor-backend",
  "version": "0.1.0",
  "description": "Backend API for the government server monitoring system",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev":   "node --watch src/server.js",
    "test":  "vitest run --reporter=verbose",
    "seed":  "node src/scripts/seed.js"
  },
  "vitest": {
    "environment": "node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.33.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
