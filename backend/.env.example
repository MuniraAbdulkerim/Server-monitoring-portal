# =============================================================================
# Server Monitoring Portal — Backend Environment Variables
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Server ---
PORT=4000

# --- PostgreSQL (matches docker-compose.yml defaults) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=monitor_user
DB_PASSWORD=monitor_pass
DB_NAME=server_monitor

# --- CORS ---
# Comma-separated list of allowed origins for the browser dashboard.
# Example: http://localhost:5173,https://monitor.example.com
CORS_ORIGIN=http://localhost:5173

# --- Server offline detection ---
# How many seconds without a health report before a server is marked OFFLINE.
# Default: 300 (5 minutes). The collector sends every 60 s so 300 s gives
# roughly 5 missed cycles before declaring offline.
SERVER_OFFLINE_TIMEOUT_SECONDS=300

# --- SMTP (optional — alerts are saved to DB regardless) ---
# If not set, email notifications are silently skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- JWT (dashboard user authentication) ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED — the backend will log an error and return 500 if this is missing.
JWT_SECRET=
# How long dashboard tokens are valid.  Examples: 8h, 1d, 7d
JWT_EXPIRES_IN=8h
