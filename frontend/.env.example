# Frontend environment variables (Vite)
# Copy to .env and adjust as needed.
# Variables MUST be prefixed with VITE_ to be available in the browser.

# Backend API base URL (REST)
# Leave unset to use a relative path (works when frontend and backend share the same origin).
# Set explicitly when running frontend and backend on separate origins.
# Example: VITE_API_URL=http://localhost:4000/api/v1
VITE_API_URL=

# Backend base URL for WebSocket connection (no /api/v1 suffix)
# Leave unset to use window.location.origin (works on any host).
# Example: VITE_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=
