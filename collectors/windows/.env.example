# =============================================================================
# Windows Monitoring Collector — Configuration
# =============================================================================
# Copy this file to .env in the same directory and fill in the values.
# NEVER commit the .env file to version control.
# The AGENT_API_TOKEN must NEVER be logged or printed.
# =============================================================================

# Backend API health endpoint
API_URL=http://your-backend-server:4000/api/v1/health

# Per-server agent token — obtained from the inventory UI at registration time.
# This value is shown ONCE. Store it here and nowhere else.
AGENT_API_TOKEN=

# Server ID that was used when registering this machine in the inventory.
# Default if blank: srv-<hostname> (lowercased)
SERVER_ID=

# How often to collect and send metrics (seconds). Default: 60
COLLECTION_INTERVAL_SECONDS=60

# Comma-separated list of Windows service names to monitor.
# These are the short service names visible in services.msc "Name" column.
# Default: spooler,w32time,WinDefend,EventLog,Dnscache
IMPORTANT_SERVICES=spooler,w32time,WinDefend,EventLog,Dnscache

# Whether to attempt Windows Server Backup status collection.
# Set to false on machines that do not have wbadmin installed.
BACKUP_ENABLED=true

# HTTP timeout in seconds for each API call. Default: 15
HTTP_TIMEOUT_SECONDS=15
